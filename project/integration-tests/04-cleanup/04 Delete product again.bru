meta {
  name: Delete product again
  type: http
  seq: 4
}

delete {
  url: {{baseUrl}}/products/{{productId}}
  body: none
  auth: inherit
}

tests {
  test("returns 404 Not Found", function () {
    expect(res.getStatus()).to.equal(404);
  });

  test("says which product is missing", function () {
    expect(res.getBody().error).to.equal(`product ${bru.getVar("productId")} not found`);
  });
}
