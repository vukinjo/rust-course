meta {
  name: List products with a lowercase scheme
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/products
  body: none
  auth: none
}

headers {
  Authorization: bearer 0123456789
}

tests {
  test("returns 200 OK", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("accepts the scheme in any letter case (RFC 9110)", function () {
    expect(res.getBody()).to.be.an("array");
  });
}
