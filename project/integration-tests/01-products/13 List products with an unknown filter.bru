meta {
  name: List products with an unknown filter
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/products?colour=red
  body: none
  auth: inherit
}

tests {
  test("returns 400 Bad Request", function () {
    expect(res.getStatus()).to.equal(400);
  });

  test("names the unknown query parameter", function () {
    expect(res.getBody()).to.contain("unknown field `colour`");
  });
}
