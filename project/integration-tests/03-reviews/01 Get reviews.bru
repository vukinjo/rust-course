meta {
  name: Get reviews
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/products/{{productId}}/reviews
  body: none
  auth: inherit
}

docs {
  The service fetches `/comments?postId={id}` from its reviews service (jsonplaceholder.typicode.com by
  default, see config/base.yaml), so this needs internet access. jsonplaceholder only has comments for
  ids 1–100, so a product with a higher id gets an empty list.
}

tests {
  const body = res.getBody();

  test("returns 200 OK", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns a list of reviews with author, title and body", function () {
    expect(body).to.be.an("array");
    body.forEach((r) => {
      expect(r).to.have.all.keys("author", "title", "body");
      expect(r.author).to.contain("@"); // jsonplaceholder's comment email
    });
  });
}
