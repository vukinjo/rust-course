meta {
  name: Get reviews of a missing product
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/products/00000000-0000-7000-8000-000000000000/reviews
  body: none
  auth: inherit
}

docs {
  An unknown product is "not found" without a call to the reviews service.
}

tests {
  test("returns 404 Not Found", function () {
    expect(res.getStatus()).to.equal(404);
  });

  test("says which product is missing", function () {
    expect(res.getBody().error).to.equal("product 00000000-0000-7000-8000-000000000000 not found");
  });
}
